# local-ctf configuration — copy to config.env and edit.
#   cp config.env.example config.env
# config.env is read by every script in scripts/.

# ── Network ──────────────────────────────────────────────────────────────
# LAN IP of the CORE laptop (runs CTFd, MySQL, registry). Must be static
# (DHCP reservation or fixed IP) — players and agent laptops use it.
CTF_HOST=192.168.1.50

# Optional DNS name for the core laptop if campus DNS / hosts files provide
# one (e.g. ctf.ensa.local). Added to the TLS certificate. Leave empty if none.
CTF_HOSTNAME=

# ── Event ────────────────────────────────────────────────────────────────
EVENT_NAME="Club CTF"
# Flags look like PREFIX{32 hex chars}
FLAG_PREFIX=CTF

# true = custom dark theme + GOAL! animation; false = CTFd's default theme
BRANDING=false

# ── Challenge instances ──────────────────────────────────────────────────
# Max running instances per team at once
MAX_ACTIVE_PER_TEAM=4
# Instances are stopped automatically after this many minutes
INSTANCE_LIFETIME_MINUTES=60

# ── Sizing (defaults fit one 16 GB laptop for ~20 teams) ────────────────
CTFD_REPLICAS=2
CTFD_WORKERS=3

# ── Admin ────────────────────────────────────────────────────────────────
CTFD_ADMIN_NAME=admin
CTFD_ADMIN_EMAIL=admin@ctf.local

# CTFd base image tag (ctfd/ctfd:<tag>). "latest" is what InfoDays ran on.
# Once a round works, pin the exact version (docker image inspect ctfd/ctfd)
# so a rebuild never changes CTFd mid-semester.
CTFD_VERSION=latest
