# Per-team zips for static challenges, generated by scripts/build-static.py
# into build/static/{challenge_id}/{team_id}.zip. Build context: build/static
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --chown=101:101 . /usr/share/nginx/html/
RUN printf 'server {\n  listen 8080;\n  server_name _;\n  root /usr/share/nginx/html;\n  autoindex off;\n  location / { try_files $uri =404; }\n}\n' \
    > /etc/nginx/conf.d/default.conf
